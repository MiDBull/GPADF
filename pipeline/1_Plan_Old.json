{
	"name": "1_Plan_Old",
	"properties": {
		"description": "Incremental sync of Plans to CRM new_plan entity with upsert",
		"activities": [
			{
				"name": "RunPlanPipeline",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "staging.usp_RunPlanPipeline"
				},
				"linkedServiceName": {
					"referenceName": "DataMigrationProd",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "GetDistinctClientCodes",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "RunPlanPipeline",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlSource",
						"sqlReaderQuery": "SELECT STUFF((SELECT ',' + CAST(ClientCode AS NVARCHAR(100)) FROM (SELECT DISTINCT ClientCode FROM staging.Plans_Staging WHERE SyncStatus = 'Processing') sub FOR XML PATH(''), TYPE).value('.', 'NVARCHAR(MAX)'),1,1,'') AS ClientCodes",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQL_PlanStaging",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				},
				"linkedServiceName": {
					"referenceName": "DataMigrationProd",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "ClientGUID_Lookup",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "GetDistinctClientCodes",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DynamicsSource",
						"query": {
							"value": "@if(empty(activity('GetDistinctClientCodes').output.firstRow.ClientCodes), '<fetch><entity name=\"contact\"><attribute name=\"contactid\"/><attribute name=\"new_clientid\"/><filter><condition attribute=\"new_clientid\" operator=\"eq\" value=\"00000000\"/></filter></entity></fetch>', concat('<fetch><entity name=\"contact\"><attribute name=\"contactid\"/><attribute name=\"new_clientid\"/><filter type=\"and\"><condition attribute=\"new_clientid\" operator=\"in\">', concat('<value>', replace(activity('GetDistinctClientCodes').output.firstRow.ClientCodes, ',', '</value><value>'), '</value>'), '</condition></filter></entity></fetch>'))",
							"type": "Expression"
						}
					},
					"dataset": {
						"referenceName": "Dynamics_contact",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "InsertClientContactGUIDs",
