{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "GPDFactory"
		},
		"Dataverse_prod_servicePrincipalCredential": {
			"type": "secureString",
			"metadata": "Secure string for 'servicePrincipalCredential' of 'Dataverse_prod'"
		},
		"Dynamics365_servicePrincipalCredential": {
			"type": "secureString",
			"metadata": "Secure string for 'servicePrincipalCredential' of 'Dynamics365'"
		},
		"Dynamics365v2_servicePrincipalCredential": {
			"type": "secureString",
			"metadata": "Secure string for 'servicePrincipalCredential' of 'Dynamics365v2'"
		},
		"DynamicsProd_servicePrincipalCredential": {
			"type": "secureString",
			"metadata": "Secure string for 'servicePrincipalCredential' of 'DynamicsProd'"
		},
		"PipelineLogs_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'PipelineLogs'"
		},
		"VieFundProd_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'VieFundProd'"
		},
		"Dataverse_prod_properties_typeProperties_servicePrincipalId": {
			"type": "string",
			"defaultValue": "ef1fb8c3-0e5c-4109-be9c-c8cbd90f857d"
		},
		"Dynamics365_properties_typeProperties_servicePrincipalId": {
			"type": "string",
