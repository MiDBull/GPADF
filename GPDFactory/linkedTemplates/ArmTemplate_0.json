			"type": "string",
			"defaultValue": "ef1fb8c3-0e5c-4109-be9c-c8cbd90f857d"
		},
		"VieFundProd_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "VieFund"
		},
		"VieFundProd_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "VieFUND"
		},
		"VieFundProd_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "vie"
		}
	},
